---
import { content } from '../data/content';
import '../styles/global.css';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = content[lang];
const url = `https://hicham.bouchikhi.net${lang === 'fr' ? '/' : '/en/'}`;
const github = 'https://github.com/hicham-bouchikhi';
const structured = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Hicham Bouchikhi',
  url: 'https://hicham.bouchikhi.net/', jobTitle: 'Senior Software Engineer / Tech Lead',
  sameAs: [github, 'https://www.linkedin.com/in/hicham-bouchikhi/'],
  knowsAbout: ['C#', '.NET', 'OpenID Connect', 'Azure', 'Linux'],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f0" /><title>{t.title}</title>
    <meta name="description" content={t.description} /><link rel="canonical" href={url} />
    <link rel="alternate" hreflang="fr" href="https://hicham.bouchikhi.net/" />
    <link rel="alternate" hreflang="en" href="https://hicham.bouchikhi.net/en/" />
    <link rel="alternate" hreflang="x-default" href="https://hicham.bouchikhi.net/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" /><meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} /><meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.skip}</a>
    <header class="wrap header">
      <a href={lang === 'fr' ? '/' : '/en/'} class="brand" aria-label="Hicham Bouchikhi">hicham<span>.</span></a>
      <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        {t.nav.map((label, i) => <a href={`#${['projects', 'expertise', 'experience'][i]}`}>{label}</a>)}
      </nav>
      <div class="header-actions"><div class="languages" aria-label={lang === 'fr' ? 'Langue' : 'Language'}><a href="/" lang="fr" aria-current={lang === 'fr' ? 'page' : undefined}>FR</a><span>/</span><a href="/en/" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a></div><a class="contact-link" href="#contact">{t.contact} <span aria-hidden="true">↗</span></a></div>
    </header>
    <main id="main">
      <section class="wrap hero" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow"><span class="dot"></span>{t.location}</p>
          <h1 id="hero-title">{t.headline[0]}<br /><span>{t.headline[1]}</span></h1>
          <p class="intro">{t.intro}</p>
          <div class="hero-actions"><a class="button primary" href="#projects">{t.projectCta}<span aria-hidden="true">↗</span></a><a class="cv-link" href={`/cv/${t.cvFile}`}>{t.cv}<span aria-hidden="true">↓</span></a></div>
          <div class="proof"><div><strong>10+</strong><span>{t.proof[0]}</span></div><div><strong>.NET / C#</strong><span>{t.proof[1]}</span></div><div><strong>Open source</strong><span>{t.proof[2]}</span></div></div>
        </div>
        <div class="hero-art" aria-hidden="true"><div class="art-caption"><span>THE ENGINEERING DESK</span><span>HB — 01</span></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="core">h<span>.</span></div><span class="floating-pill pill-one"><i></i> systems that work</span><span class="floating-pill pill-two">&lt;/&gt; built with purpose</span><div class="art-bottom"><span>architecture → code → production</span><span>↗</span></div></div>
        <p class="hero-note"><span>↓</span>{t.note}</p>
      </section>
      <section class="wrap section projects" id="projects" aria-labelledby="projects-title">
        <p class="eyebrow">{t.workLabel}</p><div class="section-heading"><div><h2 id="projects-title">{t.workTitle}</h2><p>{t.workIntro}</p></div><a class="text-link" href={github}>{t.allCode} ↗</a></div>
        <div class="project-grid">{t.projects.map(project => <article class="project-card">
          <div class={`project-visual ${project.style}`} aria-hidden="true"><div class="visual-top"><span>{project.kind}</span><span>{project.number}</span></div>
            {project.style === 'light' && <div class="wave">{Array.from({ length: 33 }, (_, i) => <i style={`--height:${18 + ((i * 17 + 11) % 72)}%;--n:${i}`} />)}</div>}
            {project.style === 'mods' && <div class="mod-art"><div class="mod-title">V<span>_</span></div><div class="mod-stack"><span>01 / discover</span><span>02 / inspect</span><span>03 / deploy <b>↗</b></span></div></div>}
            {project.style === 'hub' && <div class="hub-art"><div class="hub-side"><i></i><i></i><i></i></div><div class="hub-grid"><div><b>Inbox</b><span>Outlook</span></div><div><b>Reviews</b><span>Azure DevOps</span></div><div><b>Messages</b><span>Teams</span></div><div><b>Focus</b><span>Today</span></div></div></div>}
            {project.style === 'mic' && <div class="mic-art"><div class="mic-body"><div class="mic-led"></div></div><div class="mic-stand"></div><span>0x01 → connected</span></div>}
            <div class="visual-bottom"><strong>{project.name}</strong><span>{project.visual}</span></div>
          </div>
          <div class="project-body"><h3><a href={`${github}/${project.repo}`}>{project.title}<span aria-hidden="true">↗</span></a></h3><p>{project.description}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><a class="project-source" href={`${github}/${project.repo}`}>{t.source}<span class="sr-only"> {project.name}</span> ↗</a></div>
        </article>)}</div>
      </section>
      <section class="expertise-band" id="expertise" aria-labelledby="expertise-title"><div class="wrap expertise-layout"><div><p class="eyebrow">{t.expertiseLabel}</p><h2 id="expertise-title" class="multiline">{t.expertiseTitle}</h2><p class="expertise-intro">{t.expertiseIntro}</p><div class="signature" aria-hidden="true">{ } <span>Make it work.<br />Make it clear.</span></div></div><div class="expertise-list">{t.expertise.map(([n, title, text]) => <article><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div><span aria-hidden="true">↗</span></article>)}</div></div></section>
      <section class="wrap section experience" id="experience" aria-labelledby="experience-title"><p class="eyebrow">{t.experienceLabel}</p><div class="section-heading"><div><h2 id="experience-title">{t.experienceTitle}</h2><p>{t.experienceIntro}</p></div><a class="text-link" href={`/cv/${t.cvFile}`}>{t.cv} ↓</a></div><div class="timeline">{t.experience.map(([date, company, role, description]) => <article><p class="date">{date}</p><div><h3>{company}</h3><p class="role">{role}</p></div><p>{description}</p></article>)}</div></section>
      <section class="wrap contact-section" id="contact" aria-labelledby="contact-title"><div class="contact-card"><div><p class="eyebrow">{t.contactLabel}</p><h2 class="multiline" id="contact-title">{t.contactTitle}</h2><p>{t.contactIntro}</p><a class="button primary" href="mailto:hicham@bouchikhi.net">{t.emailCta} ↗</a></div><a class="contact-symbol" href="mailto:hicham@bouchikhi.net" aria-label="hicham@bouchikhi.net">↗</a><div class="contact-bottom"><a href="mailto:hicham@bouchikhi.net">hicham@bouchikhi.net</a><div><a href={github}>GitHub ↗</a><a href="https://www.linkedin.com/in/hicham-bouchikhi/">LinkedIn ↗</a></div></div></div></section>
    </main>
    <footer class="wrap footer"><a class="brand" href="#top">hicham<span>.</span></a><p>© {new Date().getFullYear()} Hicham Bouchikhi · {t.footer}</p><a href="#top">{t.top} ↑</a></footer>
  </body>
</html>
