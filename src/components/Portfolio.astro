---
import { content } from '../data/content';
import '../styles/global.css';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = content[lang];
const fr = lang === 'fr';
const github = 'https://github.com/hicham-bouchikhi';
const url = `https://hicham.bouchikhi.net${fr ? '/' : '/en/'}`;
const projects = [
  { ...t.projects[0], image: '/projects/light-sync.webp', width: 1180, height: 860, caption: fr ? 'Capture de l’application · mode écran' : 'Application screenshot · screen mode', discipline: 'DESKTOP / AUDIO / HARDWARE' },
  { ...t.projects[1], image: '/projects/vortnux.webp', width: 1440, height: 1440, caption: fr ? 'Capture de l’application · données de démonstration' : 'Application screenshot · demo data', discipline: 'DESKTOP / GAMING / LINUX' },
  { name: 'Hypricing', number: '03', repo: 'Hypricing', title: fr ? 'Un panneau de contrôle pour Hyprland.' : 'A control panel for Hyprland.', description: fr ? 'Configurer son bureau Linux depuis une interface native : écrans, raccourcis, audio et Bluetooth. Construit avec C# et Avalonia, publié en Native AOT.' : 'Configure a Linux desktop from a native interface: monitors, shortcuts, audio and Bluetooth. Built with C# and Avalonia, published with Native AOT.', tags: ['C#', 'Avalonia', 'Hyprland'], image: '/projects/hypricing.webp', width: 1616, height: 1368, caption: fr ? 'Capture de l’application · Bluetooth' : 'Application screenshot · Bluetooth', discipline: 'DESKTOP / WAYLAND / TOOLING' },
];
const websites = [
  { name: 'Emmanuelle Facchineri', url: 'https://emmanuelle.facchineri.com/', domain: 'emmanuelle.facchineri.com', image: '/projects/emmanuelle-website.webp', category: fr ? 'MUSIQUE / SITE VITRINE' : 'MUSIC / SHOWCASE WEBSITE', description: fr ? 'Un site pour présenter les cours de piano à Saint-Étienne : parcours, offres, actualités et réservation en ligne.' : 'A website presenting piano lessons in Saint-Étienne: background, courses, news and online booking.', tags: ['Web', 'Next.js', fr ? 'Réservation' : 'Booking'] },
  { name: 'Clinika Espoir', url: 'https://clinikaespoir.com/', domain: 'clinikaespoir.com', image: '/projects/clinika-website.webp', category: fr ? 'SANTÉ / SITE MULTILINGUE' : 'HEALTHCARE / MULTILINGUAL WEBSITE', description: fr ? 'Un site multilingue pour présenter les parcours de fertilité au Maroc, guider les patients et faciliter la prise de contact.' : 'A multilingual website presenting fertility care pathways in Morocco, guiding patients and making it easier to get in touch.', tags: ['Web', 'Astro', 'CMS / Directus'] },
];
const labels = {
  job: fr ? 'INGÉNIEUR LOGICIEL / TECH LEAD' : 'SOFTWARE ENGINEER / TECH LEAD',
  intro: fr ? 'Ingénieur logiciel et tech lead à Lyon. Je conçois des plateformes .NET, des sites web et des outils open source pour Linux. Du premier prototype à la mise en production.' : 'Software engineer and tech lead based in Lyon. I build .NET platforms, websites and open-source tools for Linux. From the first prototype to production.',
  cv: fr ? 'Télécharger mon CV' : 'Download my CV',
  work: fr ? 'Quelques projets.' : 'Selected work.',
  workIntro: fr ? 'Du temps libre, du code et des problèmes qui méritaient un outil.' : 'Spare time, code, and problems that deserved a tool.',
  more: fr ? 'Aussi sur mon établi' : 'Also on my workbench',
  expertise: fr ? 'Architecture.\nDéveloppement.\nProduction.' : 'Architecture.\nDevelopment.\nProduction.',
  expertiseText: fr ? 'Plus de dix ans sur des logiciels métiers, dans la finance, l’énergie et le cloud. Mon point de départ reste le même : comprendre le problème, choisir une architecture adaptée et livrer quelque chose qui tient en production.' : 'Over ten years working on business software across finance, energy and cloud platforms. The starting point stays the same: understand the problem, choose the right architecture and deliver something that holds up in production.',
  experience: fr ? 'Le parcours.' : 'The experience.',
  contact: fr ? 'Un projet\nen tête ?' : 'A project\nin mind?' ,
  contactText: fr ? 'Un projet, une question, un problème technique intéressant ? Ma boîte mail est ouverte.' : 'A project, a question, an interesting engineering problem? My inbox is open.',
  screenshot: fr ? 'Agrandir la capture' : 'Open full screenshot',
};
const schema = { '@context':'https://schema.org', '@type':'Person', name:'Hicham Bouchikhi', url:'https://hicham.bouchikhi.net/', jobTitle:'Senior Software Engineer / Tech Lead', sameAs:[github,'https://www.linkedin.com/in/hicham-bouchikhi/'], knowsAbout:['C#','.NET','OpenID Connect','Azure','Linux'] };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101112" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="fr" href="https://hicham.bouchikhi.net/" />
    <link rel="alternate" hreflang="en" href="https://hicham.bouchikhi.net/en/" />
    <link rel="alternate" hreflang="x-default" href="https://hicham.bouchikhi.net/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={fr ? 'fr_FR' : 'en_GB'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.skip}</a>
    <header class="shell header">
      <a class="wordmark" href={fr ? '/' : '/en/'} aria-label="Hicham Bouchikhi"><span class="monogram">hb<span>_</span></span><span class="wordmark-name">HICHAM<br />BOUCHIKHI</span></a>
      <nav aria-label={fr ? 'Navigation principale' : 'Main navigation'}>{(fr ? ['Réalisations','Open source','Parcours'] : ['Work','Open source','Experience']).map((label,i) => <a href={`#${['projects','open-source','experience'][i]}`}>{label}</a>)}</nav>
      <div class="header-end"><div class="languages" aria-label={fr ? 'Langue' : 'Language'}><a href="/" lang="fr" aria-current={fr ? 'page' : undefined}>FR</a><span>/</span><a href="/en/" lang="en" aria-current={!fr ? 'page' : undefined}>EN</a></div><a class="header-contact" href="mailto:hicham@bouchikhi.net">Contact <span aria-hidden="true">↗</span></a></div>
    </header>
    <main id="main">
      <section class="shell hero" aria-labelledby="hero-title">
        <div class="hero-meta"><p class="eyebrow"><span class="status-dot"></span>{labels.job}</p><p class="eyebrow location">LYON, FRANCE <span aria-hidden="true">↗</span></p></div>
        <div class="scene-shell" data-scene aria-hidden="true"><div class="scene-fallback"></div><div class="scene-host" data-scene-host></div><span class="scene-label">FORM / FUNCTION<br />LIVE OBJECT — 001</span></div>
        <h1 id="hero-title">Hicham<br /><span class="surname">Bouchikhi<span class="name-period">.</span></span></h1>
        <div class="hero-bottom"><div class="hero-specialties"><span>.NET / C#</span><span>LINUX / OPEN SOURCE</span><span>ARCHITECTURE / PERFORMANCE</span></div><div class="hero-summary"><p>{labels.intro}</p><div class="hero-actions"><a class="button button-accent" href="#projects">{fr ? 'Voir les projets' : 'Explore projects'} <span aria-hidden="true">↓</span></a><a class="inline-link" href={`/cv/${t.cvFile}`}>{labels.cv} <span aria-hidden="true">↗</span></a></div></div></div>
        <div class="scene-controls"><button class="motion-toggle" data-motion-toggle data-pause={fr ? 'METTRE LA 3D EN PAUSE Ⅱ' : 'PAUSE 3D Ⅱ'} data-resume={fr ? 'RELANCER LA 3D ▷' : 'RESUME 3D ▷'} aria-pressed="false" hidden>{fr ? 'METTRE LA 3D EN PAUSE Ⅱ' : 'PAUSE 3D Ⅱ'}</button></div>
        <div class="hero-strip" aria-hidden="true"><span>01 — BACKEND</span><span>02 — DESKTOP</span><span>03 — LINUX</span><span>04 — HARDWARE</span><span class="strip-end">ALWAYS BUILDING ↙</span></div>
      </section>

      <section class="shell web-section section" id="projects" aria-labelledby="web-title">
        <div class="section-top"><p class="eyebrow">01 / {fr ? 'RÉFÉRENCES WEB' : 'WEB REFERENCES'}</p><span class="eyebrow">{fr ? 'EN LIGNE ↗' : 'LIVE ↗'}</span></div>
        <div class="work-heading"><h2 id="web-title">{fr ? 'Sites web.' : 'Web projects.'}</h2><p>{fr ? 'Deux sites auxquels j’ai contribué, pour des métiers et des publics très différents.' : 'Two websites I’ve worked on, for very different businesses and audiences.'}</p></div>
        <div class="web-grid">{websites.map(website => <article class="web-project" data-reveal>
          <a class="web-preview" href={website.url} aria-label={fr ? `Visiter ${website.name}` : `Visit ${website.name}`}><span class="web-window"><span class="window-bar" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>{website.domain}</span><span>↗</span></span><span class="web-image"><img src={website.image} width="1440" height="1000" alt={fr ? `Page d’accueil du site ${website.name}` : `${website.name} homepage`} loading="lazy" decoding="async" /></span></span></a>
          <p class="web-kicker"><span>{website.category}</span><span>{fr ? 'CONTRIBUTION AU PROJET' : 'PROJECT CONTRIBUTION'}</span></p><h3><a href={website.url}>{website.name}<span aria-hidden="true">↗</span></a></h3><p class="web-description">{website.description}</p><ul class="tags" aria-label="Technologies">{website.tags.map(tag=><li>{tag}</li>)}</ul>
        </article>)}</div>
      </section>
      <section class="shell work-section section" id="open-source" aria-labelledby="work-title">
        <div class="section-top"><p class="eyebrow">02 / {fr ? 'PROJETS PERSONNELS' : 'PERSONAL PROJECTS'}</p><a class="inline-link muted-link" href={github}>GitHub <span aria-hidden="true">↗</span></a></div>
        <div class="work-heading"><h2 id="work-title">{labels.work}</h2><p>{labels.workIntro}</p></div>
        <div class="featured-projects">{projects.map((project,i) => <article class:list={['project',`project-${i + 1}`]} data-reveal>
          <div class="project-copy"><p class="project-index"><span>0{i + 1}</span> / {project.discipline}</p><h3><a href={`${github}/${project.repo}`}>{project.name}<span aria-hidden="true">↗</span></a></h3><p class="project-subtitle">{project.title}</p><p class="project-description">{project.description}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><a class="source-link" href={`${github}/${project.repo}`}>{fr ? 'Explorer le code' : 'Explore the code'} <span class="sr-only">{project.name}</span> <span aria-hidden="true">↗</span></a></div>
          <figure class="project-media"><a href={project.image} aria-label={`${labels.screenshot} — ${project.name}`}><div class="window-bar" aria-hidden="true"><div class="window-dots"><i></i><i></i><i></i></div><span>{project.repo.toLowerCase()} / screenshot</span><span>↗</span></div><div class="screenshot-frame"><img src={project.image} alt={fr ? `Interface de ${project.name}` : `${project.name} interface`} width={project.width} height={project.height} loading="lazy" decoding="async" /></div></a><figcaption>{project.caption}</figcaption></figure>
        </article>)}</div>
        <div class="more-projects"><p class="eyebrow">{labels.more}</p>{t.projects.slice(2).map(project => <a class="more-project" href={`${github}/${project.repo}`}><span class="more-name">{project.name}</span><span class="more-description">{project.description}</span><span class="more-stack">{project.tags.slice(0,2).join(' / ')}</span><span class="more-arrow" aria-hidden="true">↗</span></a>)}</div>
      </section>

      <section class="expertise-section" id="expertise" aria-labelledby="expertise-title"><div class="shell expertise-layout"><div class="expertise-heading"><p class="eyebrow">03 / {fr ? 'EXPERTISE' : 'EXPERTISE'}</p><h2 class="multiline" id="expertise-title">{labels.expertise}</h2><p class="expertise-intro">{labels.expertiseText}</p><div class="years"><strong>10<span>+</span></strong><span>{fr ? 'ANNÉES À CONSTRUIRE\nDES LOGICIELS' : 'YEARS BUILDING\nSOFTWARE'}</span></div></div><div class="expertise-list">{t.expertise.map(([n,title,description]) => <article><span class="expertise-index">{n}</span><div><h3>{title}</h3><p>{description}</p></div></article>)}</div></div></section>

      <section class="shell section experience-section" id="experience" aria-labelledby="experience-title"><div class="section-top"><p class="eyebrow">04 / {fr ? 'EXPÉRIENCE' : 'EXPERIENCE'}</p><a class="inline-link muted-link" href={`/cv/${t.cvFile}`}>{fr ? 'CV complet' : 'Full CV'} ↗</a></div><h2 id="experience-title">{labels.experience}</h2><div class="timeline">{t.experience.map(([date,company,role,description],i) => <article><p class:list={['date',{ current:i===0 }]}>{i===0 && <span class="status-dot"></span>}{date}</p><div class="experience-company"><h3>{company}</h3><p>{role}</p></div><p class="experience-description">{description}</p></article>)}</div></section>

      <section class="shell contact-section" id="contact" aria-labelledby="contact-title"><div class="contact-top"><p class="eyebrow">05 / CONTACT</p><p class="eyebrow">{fr ? 'LE PROCHAIN SUJET ?' : 'WHAT’S NEXT?'}</p></div><div class="contact-main"><div><h2 id="contact-title" class="multiline">{labels.contact}</h2><p>{labels.contactText}</p></div><a class="contact-arrow" href="mailto:hicham@bouchikhi.net" aria-label={fr ? 'Écrire à Hicham Bouchikhi' : 'Email Hicham Bouchikhi'}>↗</a></div><div class="contact-links"><a class="email" href="mailto:hicham@bouchikhi.net">hicham@bouchikhi.net <span aria-hidden="true">↗</span></a><div><a href={github}>GitHub ↗</a><a href="https://www.linkedin.com/in/hicham-bouchikhi/">LinkedIn ↗</a><a href={`/cv/${t.cvFile}`}>CV / PDF ↗</a></div></div></section>
    </main>
    <script>import '../scripts/interactions';</script>
    <footer class="shell footer"><p>© {new Date().getFullYear()} Hicham Bouchikhi</p><span>DESIGNED TO WORK. BUILT TO LAST.</span><a href="#top">{t.top} ↑</a></footer>
  </body>
</html>
